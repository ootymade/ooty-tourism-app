# Copy this file to .env and fill in real values.
# Expo only exposes env vars prefixed EXPO_PUBLIC_ to client code — never put
# secret keys (e.g. the Anthropic API key) here; those belong server-side in
# Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Crash reporting (Sentry). Leave blank to keep it disabled.
EXPO_PUBLIC_SENTRY_DSN=

# Privacy-respecting product analytics (PostHog). Leave blank to keep it
# disabled — no client is constructed and no network call is made without
# a key. EXPO_PUBLIC_POSTHOG_HOST defaults to PostHog Cloud (US) if unset.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
